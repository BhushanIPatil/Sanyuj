# Public (safe for browser)
NEXT_PUBLIC_OFFER_REQUEST_FORM_URL=
NEXT_PUBLIC_NOTIFICATION_REQUEST_FORM_URL=
NEXT_PUBLIC_CONTACT_FORM_URL=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (notification registration and admin push APIs). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Firebase Cloud Messaging (server). Paste the full service-account JSON as a
# single line, OR base64-encode the JSON file contents.
# Download from Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Optional: comma-separated extra CORS origins (e.g. production admin URL).
# CORS_ALLOWED_ORIGINS=https://admin.sanyuj.app

# Public site, Google Play and social links. Replace placeholder URLs and rebuild.
NEXT_PUBLIC_SITE_URL=https://sanyuj.vercel.app
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.sanyuj
NEXT_PUBLIC_LINKEDIN_URL=https://example.com/sanyuj/linkedin
NEXT_PUBLIC_INSTAGRAM_URL=https://example.com/sanyuj/instagram
NEXT_PUBLIC_X_URL=https://example.com/sanyuj/x
NEXT_PUBLIC_FACEBOOK_URL=https://example.com/sanyuj/facebook
NEXT_PUBLIC_YOUTUBE_URL=https://example.com/sanyuj/youtube
